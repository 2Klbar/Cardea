{ "id": "system", "name": "System packages (apt)", "scope": "image",
  "setup": "apt-get update",
  "install": "apt-get install -y --no-install-recommends \"$1${2:+=$2}\"",
  "remove": "apt-get remove -y \"$1\"",
  "update": "apt-get install -y --only-upgrade \"$1\"",
  "list": "dpkg-query -W -f '${Package} ${Version}\\n'" }
