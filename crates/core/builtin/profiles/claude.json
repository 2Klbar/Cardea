{
  "schema": 1,
  "id": "claude",
  "name": "Claude",
  "description": "Claude Desktop and Claude Code, with FreeCAD, Firefox and development tools (Node, Go, Rust, Python, C/C++).",
  "icon": { "letter": "C", "color": "#c8643b" },
  "base_image": "docker.io/library/debian:trixie-slim",
  "trust": "work",
  "capabilities": { "wayland": true, "x11": "off", "gpu": true, "kvm": false,
                    "keyring": { "mode": "auto", "keep": false } },
  "security": { "seccomp": true, "isolated_uid": false, "ram_limit_gb": null },
  "apt_repos": [
    { "name": "claude-desktop", "url": "https://downloads.claude.ai/claude-desktop/apt/stable",
      "suite": "stable", "components": ["main"], "key_url": "https://downloads.claude.ai/claude-desktop/key.asc",
      "fingerprint": "31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE" }
  ],
  "packages": [
    { "source": "system", "name": "ca-certificates" },
    { "source": "system", "name": "curl" },
    { "source": "system", "name": "git" },
    { "source": "system", "name": "openssh-client" },
    { "source": "system", "name": "less" },
    { "source": "system", "name": "nano" },
    { "source": "system", "name": "vim-tiny" },
    { "source": "system", "name": "jq" },
    { "source": "system", "name": "ripgrep" },
    { "source": "system", "name": "procps" },
    { "source": "system", "name": "iproute2" },
    { "source": "system", "name": "unzip" },
    { "source": "system", "name": "xz-utils" },
    { "source": "system", "name": "file" },
    { "source": "system", "name": "build-essential" },
    { "source": "system", "name": "pkg-config" },
    { "source": "system", "name": "libssl-dev" },
    { "source": "system", "name": "libpam0g-dev" },
    { "source": "system", "name": "cmake" },
    { "source": "system", "name": "shellcheck" },
    { "source": "system", "name": "python3" },
    { "source": "system", "name": "python3-venv" },
    { "source": "system", "name": "python3-pip" },
    { "source": "system", "name": "pipx" },
    { "source": "system", "name": "gnupg" },
    { "source": "system", "name": "libsecret-1-0" },
    { "source": "system", "name": "desktop-file-utils" },
    { "source": "system", "name": "shared-mime-info" },
    { "source": "system", "name": "xdg-utils" },
    { "source": "system", "name": "fonts-dejavu-core" },
    { "source": "system", "name": "fonts-noto-color-emoji" },
    { "source": "system", "name": "firefox-esr" },
    { "source": "system", "name": "claude-desktop" },
    { "source": "system", "name": "freecad" },
    { "source": "system", "name": "qemu-system-x86", "when": { "capability": "kvm" } },
    { "source": "system", "name": "ovmf", "when": { "capability": "kvm" } },
    { "source": "system", "name": "virtiofsd", "when": { "capability": "kvm" } },
    { "source": "mise", "name": "node", "version": "lts" },
    { "source": "mise", "name": "go", "version": "latest" },
    { "source": "rustup", "name": "stable" },
    { "source": "cargo", "name": "cargo-audit" },
    { "source": "cargo", "name": "cargo-deny" },
    { "source": "pipx", "name": "graphifyy" }
  ],
  "setup": {
    "build": "",
    "first_start": "command -v claude >/dev/null || curl -fsSL https://claude.ai/install.sh | bash\n",
    "on_failure": "continue"
  },
  "apps": [
    { "id": "claude-desktop", "name": "Claude", "exec": ["claude-desktop"], "toolkit": "electron",
      "pinned": true, "desktop_entry": true },
    { "id": "claude-code", "name": "Claude Code", "exec": ["claude"], "toolkit": "terminal",
      "pinned": true, "desktop_entry": true },
    { "id": "freecad", "name": "FreeCAD", "exec": ["freecad"], "toolkit": "qt",
      "wants": ["gpu"], "pinned": true, "desktop_entry": true },
    { "id": "firefox", "name": "Firefox", "exec": ["firefox-esr"], "toolkit": "other",
      "env": { "MOZ_ENABLE_WAYLAND": "1" } }
  ],
  "services": [
    { "id": "remote-control", "name": "Remote Control",
      "exec": ["claude", "remote-control", "--name", "{folder}"], "per_folder": true }
  ],
  "appearance": { "theme": "dark", "languages": ["fr", "en"] }
}
